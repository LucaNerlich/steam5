# Stage 1: Build
FROM gradle:9.4.1-jdk21-alpine as build

# STEAM_API_KEY is a runtime-only property (loaded from .env at application
# startup, see springboot4-dotenv in build.gradle.kts) — the Gradle build never
# reads it, so it must not be declared here. It previously was, which put its
# value into this stage's image layer history for no reason.
WORKDIR /app

# path starts in repo root
ADD ./backend .

# Build with the wrapper so the image uses the Gradle the repository pins
# (backend/gradle/wrapper/gradle-wrapper.properties) instead of whatever the base image ships —
# they had drifted (image 9.4.1 vs wrapper 9.8.1) and nothing watched the tag.
RUN ./gradlew bootJar -Dorg.springframework.boot.devinfo=true

# Stage 2: Run
# JRE, not JDK: nothing in this stage compiles or runs a JDK tool (the healthcheck uses curl and
# the CMD runs `java -jar`), so the compiler and its bundled tools need not ship to production.
FROM eclipse-temurin:21-jre-alpine as run

WORKDIR /app

# Create a new account and group for the application
RUN addgroup -S spring && adduser -S spring -G spring
RUN apk add --no-cache curl
USER spring:spring

# Copy and rename so the CMD never needs updating when the Gradle version changes
COPY --from=build /app/build/libs/steam5-*.jar app.jar

# EXPOSE is image metadata only, and it has to be declared in *this* stage: a build arg does not
# cross stages, so the previous `ARG PORT` in the build stage left `${PORT}` empty here and the
# image advertised no port (only the base image's own). The app itself listens on SERVER_PORT
# (default 8080); a build arg can still override what is advertised.
ARG PORT=8080
ENV PORT=$PORT
EXPOSE ${PORT}

# Mandatory JVM safety flags: MaxRAMPercentage respects container limits (Coolify/cgroup),
# ExitOnOutOfMemoryError makes OOMs crash-loop visibly instead of leaving a half-dead JVM
# that serves cached GETs while auth/DB paths fail.
# JAVA_EXTRA_OPTS allows Coolify to inject additional flags without losing these.
ENV JAVA_EXTRA_OPTS=""

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS "http://localhost:${MANAGEMENT_SERVER_PORT:-8081}/actuator/health" || exit 1

CMD ["sh", "-c", "exec java -XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError $JAVA_EXTRA_OPTS -jar app.jar"]
