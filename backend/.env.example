# Spring profile. REQUIRED — there is deliberately no default, so a forgotten value fails
# startup instead of silently running the dev profile (which exposes extra actuator
# endpoints and accepts the public default JWT secret). Use "dev" locally, and e.g.
# "coolify" in production.
SPRING_PROFILE=dev

# Password for the database role (SPRING_DATASOURCE_USERNAME, default "steam5_user").
# REQUIRED — deliberately no default, so a missing value fails startup instead of silently
# connecting with the credential published in setup-local-db.sql. Local dev: steam5_password;
# production: a generated secret (Coolify sets its own).
SPRING_DATASOURCE_PASSWORD=steam5_password

STEAM_API_KEY=YOUR_STEAM_API_KEY
ADMIN_API_TOKEN=

# openssl rand -base64 48
AUTH_JWT_SECRET=

# Spring Boot management/actuator port (defaults to 8081)
# MANAGEMENT_SERVER_PORT=8081

# Comma-separated actuator endpoints to expose
# Default (dev): loggers,env,beans,health,prometheus,metrics,quartz
# Default (coolify): health,prometheus
# MANAGEMENT_ENDPOINTS_EXPOSURE=health,prometheus

# HTTP Basic credentials for the protected actuator endpoints (e.g. /actuator/prometheus).
# /actuator/health remains anonymous. Defaults are "metrics" / "metrics" so dev works
# zero-config; REQUIRED to be overridden when running with the coolify profile in
# production — a startup WARN is logged otherwise. Unused in dev unless you want to
# exercise basic auth locally.
# METRICS_USERNAME=metrics
# METRICS_PASSWORD=metrics
